{
  "name": "bgmcp",
  "version": "0.2.2",
  "description": "DSH MCP 控制面插件：MCP 服务器登记/预热/回环代理与 bgjob mcp engine（依赖 bgjobs 的 engine registry）。",
  "type": "module",
  "license": "MIT",
  "author": "bgmcp-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitsmug/dsh-bgmcp.git"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./runner": "./lib/runner.mjs",
    "./runtime": "./lib/runtime.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "!lib/client-src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": ">=2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.2 || >=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.1 <0.1.2-0 || >=0.1.2-alpha.0 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "bgjobs": ">=0.4.1-beta <0.5.0 || >=0.4.1 <0.5.0",
    "react": ">=18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.22.0 || >=24.0.0 || ^22.19.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "build:client": "node scripts/build-client.mjs",
    "fix:bom": "node scripts/fix-bom.mjs --write",
    "check:bom": "node scripts/fix-bom.mjs --check"
  },
  "devDependencies": {
    "bgjobs": "link:../bgjobs",
    "esbuild": "^0.25.12"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mcp",
    "mcp-control",
    "bgjobs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
